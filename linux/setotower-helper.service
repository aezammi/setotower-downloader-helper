[Unit]
Description=Setotower Downloader Helper
Requires=setotower-helper.socket
After=setotower-helper.socket
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/setotower-helper/setotower-helper.py
WorkingDirectory=%h/.local/share/setotower-helper
NoNewPrivileges=true
PrivateTmp=true
MemoryHigh=768M
MemoryMax=1G
CPUQuota=200%
TasksMax=128
Restart=on-failure
RestartSec=2s
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
